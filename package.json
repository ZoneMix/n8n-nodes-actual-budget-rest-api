{
  "name": "n8n-nodes-actual-budget-rest-api",
  "version": "1.1.0",
  "description": "n8n community node for the Actual Budget REST API wrapper (accounts, transactions, budgets, categories, payees, rules, schedules, tags, notes)",
  "license": "MIT",
  "homepage": "https://github.com/zonemix/n8n-nodes-actual-budget-rest-api",
  "keywords": ["n8n-community-node-package"],
  "author": { "name": "ZoneMix", "email": "zonemix@zonemix.tech" },
  "repository": {
    "type": "git",
    "url": "https://github.com/zonemix/n8n-nodes-actual-budget-rest-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ActualBudgetRestApiOAuth2Api.credentials.js",
      "dist/credentials/ActualBudgetRestApiJwtApi.credentials.js"
    ],
    "nodes": ["dist/nodes/ActualBudgetRestApi/ActualBudgetRestApi.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.47.2",
    "@types/node": "22.20.2",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "release-it": "^19.0.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
